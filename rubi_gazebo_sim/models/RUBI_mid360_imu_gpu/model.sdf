          <shininess> 200 </shininess>
        </material>
      </visual>
      <visual name='R_CALF_fixed_joint_lump__R_TIP_visual_1'>
        <pose>0 0 -0.3 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://RUBI/meshes/R_TIP.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient> 0.0 0.0 0.0 1 </ambient>
          <diffuse> 1.0 1.0 1.0 1 </diffuse> 
          <specular> 1.0 1.0 1.0 1 </specular>
          <shininess> 200 </shininess>
        </material>
      </visual>
    </link>
    <link name='livox_frame_raw'>
      <pose relative_to='livox_frame'>0 0 0 3.141592653589793 0 0</pose>
      <inertial>
        <pose>0 0 0 1.5707963267948966 0 1.5707963267948966</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00011333333333333334</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00011333333333333334</iyy>
          <iyz>0</iyz>
          <izz>0.00006</izz>
        </inertia>
      </inertial>
      <visual name='livox_frame_raw_visual'>
        <geometry>
          <box>
            <size>0.1 0.06 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.10 0.12 1</ambient>
          <diffuse>0.16 0.75 0.48 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <sensor name='livox_frame_raw' type='gpu_ray'>
        <!-- GPU-rendered MID-360: gpu_livox_lidar samples this 0.2 deg range image
             along the Livox scan pattern. Same name, topic and frame as the CPU model. -->
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1800</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415927</min_angle>
              <max_angle>3.1381020</max_angle>
            </horizontal>
            <vertical>
              <samples>300</samples>
              <resolution>1</resolution>
              <min_angle>-0.1274090</min_angle>
              <max_angle>0.9128072</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>200.0</max>
            <resolution>0.002</resolution>
          </range>
        </ray>
        <plugin name='livox_frame_raw_plugin' filename='libgpu_livox_plugin.so'>
          <csv_file_name>/tmp/rubi_mid360_imu_mid360.csv</csv_file_name>
          <samples>40000</samples>
          <downsample>1</downsample>
          <topic>/livox/lidar_raw</topic>
        </plugin>
      </sensor>
      <sensor name='mid360_imu' type='imu'>
        <pose>0.011 0.02329 -0.04412 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type='gaussian'><mean>0</mean><stddev>0</stddev></noise></x>
            <y><noise type='gaussian'><mean>0</mean><stddev>0</stddev></noise></y>
            <z><noise type='gaussian'><mean>0</mean><stddev>0</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type='gaussian'><mean>0</mean><stddev>0</stddev></noise></x>
            <y><noise type='gaussian'><mean>0</mean><stddev>0</stddev></noise></y>
            <z><noise type='gaussian'><mean>0</mean><stddev>0</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name='mid360_imu_ros' filename='libgazebo_ros_imu_sensor.so'>
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=/livox/imu_raw</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>livox_frame_raw</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name='livox_frame_raw_joint' type='fixed'>
      <parent>BODY</parent>
      <child>livox_frame_raw</child>
    </joint>
    <frame name='livox_frame' attached_to='BODY'>
      <pose relative_to='BODY'>0.101 0 -0.1169 0 0 0</pose>
    </frame>
    <frame name='L_TIP_JOINT' attached_to='L_CALF'>
      <pose>0 0 -0.3 0 -0 0</pose>
    </frame>
    <frame name='L_TIP' attached_to='L_TIP_JOINT'/>
    <frame name='R_TIP_JOINT' attached_to='R_CALF'>
      <pose>0 0 -0.3 0 -0 0</pose>
    </frame>
    <frame name='R_TIP' attached_to='R_TIP_JOINT'/>
  </model>
</sdf>
